{
	# Clear the screen
	if [ "${_CLEARSCREEN}" = "YES" ]; then
		clear
	fi

	domsg ""
	domsg ""
	domsg "Error in configfile: Nothing configured for choice ${currentmenu}.${_known_choice}"
